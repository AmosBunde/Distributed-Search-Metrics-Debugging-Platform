  "cards": [
    {
      "dot": "violet",
      "title": "Relative, not absolute",
      "items": [
        "A window is scored against its own last 30 windows, per service",
        "Fixed thresholds would page on every traffic pattern change"
      ]
    },
    {
      "dot": "rose",
      "title": "Never alert on these",
      "items": [
        "Zero variance or too little history — a cold start is not an anomaly",
        "An anomaly whose signature is already firing does not page twice"
      ]
    },
    {
      "dot": "emerald",
      "title": "One source of truth",
      "items": [
        "Anomalies are published to Kafka before anything is routed",
