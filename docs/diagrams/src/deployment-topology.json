  "cards": [
    {
      "dot": "emerald",
      "title": "One chart, three clouds",
      "items": [
        "The same Helm chart deploys all five workloads",
        "Only registry, storage class, ingress annotations and endpoints differ per cloud"
      ]
    },
    {
      "dot": "violet",
      "title": "Stateless in, stateful out",
      "items": [
        "Every pod is stateless and horizontally scalable",
        "Kafka, Postgres and Redis are managed services; ClickHouse runs on dedicated VMs"
      ]
    },
    {
      "dot": "cyan",
      "title": "Scaling knobs",
      "items": [
        "The collector scales on request rate; the engine scales with Kafka partitions",
        "Raw telemetry tiers into cheaper object storage on a lifecycle policy"
      ]
    }
