    {
      "dot": "emerald",
      "title": "Ingest",
      "items": [
        "Collector validates, enriches and rate-limits every event",
        "Topics: search.events, search.results, search.errors, search.anomalies, search.spans"
      ]
    },
    {
      "dot": "violet",
      "title": "Analyse",
      "items": [
        "Metrics engine computes p50/p95/p99, relevance and error rate per window",
        "Z-score detector publishes anomalies back to Kafka"
      ]
    },
    {
      "dot": "cyan",
      "title": "Debug and serve",
