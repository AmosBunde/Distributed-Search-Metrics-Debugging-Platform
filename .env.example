# ---------------------------------------------------------------------------
# Distributed Search Metrics & Debugging Platform — local configuration
#
#   cp .env.example .env    then edit the values marked "changeme".
#   Every value below is a safe local default; none are real credentials.
# ---------------------------------------------------------------------------

# General -------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# Service ports (host side) -------------------------------------------------
API_GATEWAY_PORT=8000
COLLECTOR_PORT=8001
METRICS_ENGINE_PORT=8002
DEBUG_SERVICE_PORT=8003
DASHBOARD_PORT=3000

# Kafka ---------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_EVENTS=search.events
KAFKA_TOPIC_ERRORS=search.errors
KAFKA_TOPIC_RESULTS=search.results
KAFKA_TOPIC_ANOMALIES=search.anomalies
KAFKA_TOPIC_SPANS=search.spans
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_CONSUMER_GROUP=metrics-engine

# ClickHouse ----------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=search_metrics
CLICKHOUSE_USER=search
CLICKHOUSE_PASSWORD=changeme

# PostgreSQL ----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=search_metrics_meta
POSTGRES_USER=search
POSTGRES_PASSWORD=changeme

# Redis ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate limiting (telemetry collector) ---------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=6000
RATE_LIMIT_BURST=600
MAX_BATCH_SIZE=500

# Metrics engine ------------------------------------------------------------
WINDOW_SECONDS=60
ANOMALY_ZSCORE_THRESHOLD=3.0
ANOMALY_BASELINE_WINDOWS=30
CLICKHOUSE_INSERT_BATCH_SIZE=1000
CLICKHOUSE_INSERT_INTERVAL_SECONDS=5

# Tracing / OpenTelemetry ---------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SDK_DISABLED=false

# Observability -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_UI_PORT=16686
KAFKA_UI_PORT=8080

# Dashboard -----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# Container registries (used by `make build-push`) --------------------------
# Fill in only the one you deploy to.
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
ACR_NAME=
GCP_PROJECT=
GCP_REGION=us-central1
IMAGE_TAG=dev
